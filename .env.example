# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Authentication Configuration ---
# JWT_SECRET: Cryptographic secret key for signing and verifying JSON Web Tokens
JWT_SECRET="simlab-secret-jwt-key-production-ready-2026"

# JWT Token Expirations (e.g. 15m, 1h, 7d)
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Bcrypt Salt Work Factor (default: 10)
BCRYPT_ROUNDS=10

# Rate Limiting for Authentication Endpoints (window in milliseconds, max requests per window)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30

# PostgreSQL connection parameters (primary database; fallback engine in dev/test)
DATABASE_URL=
SQL_HOST=127.0.0.1
SQL_DB_NAME=simlab
SQL_USER=postgres
SQL_PASSWORD=
PGPORT=5432


